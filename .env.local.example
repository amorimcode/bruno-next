# Credencial OAuth do Google Cloud Console (tipo "Web application").
# Redirect URI autorizada: http://localhost:4455/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Preenchido automaticamente por `node scripts/google-oauth.mjs`.
# Só não expira se o app OAuth estiver publicado ("In production").
GOOGLE_REFRESH_TOKEN=

# Agenda usada para ler ocupação e criar os eventos.
GOOGLE_CALENDAR_ID=primary

# Opcional. Agendas extras, separadas por vírgula, lidas só para saber o que
# está ocupado. Serve para compromisso que mora em outra conta. Cada uma precisa
# estar compartilhada com a conta acima, nem que seja só "ver disponibilidade".
GOOGLE_BUSY_CALENDAR_IDS=
